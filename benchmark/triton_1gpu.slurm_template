#!/bin/bash
#SBATCH --job-name=hardrrdq
#SBATCH --partition=gpu-v100-32g
#SBATCH --gpus-per-task={{gpus_per_task}}
#SBATCH --cpus-per-gpu={{cpus_per_gpu}}
#SBATCH --ntasks={{ntasks}}
#SBATCH --array={{array}}
#SBATCH --mem=16G
#SBATCH --time=30:00:00
#SBATCH --output=benchmark/slurm/logs/%x_%A_%a.out
{{nodes}}

# Force single-thread execution per worker to avoid CPU lockup & max GPU throughput
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Parse array variables
env_ids={{env_ids}}
seeds={{seeds}}
env_id=${env_ids[$SLURM_ARRAY_TASK_ID / {{len_seeds}}]}
seed=${seeds[$SLURM_ARRAY_TASK_ID % {{len_seeds}}]}

echo "Running task $SLURM_ARRAY_TASK_ID on node $SLURMD_NODENAME | GPU: $CUDA_VISIBLE_DEVICES | env_id: $env_id | seed: $seed"

# Bind CPUs to allocated cores explicitly
srun --cpu-bind=cores {{command}} --env-id $env_id --seed $seed