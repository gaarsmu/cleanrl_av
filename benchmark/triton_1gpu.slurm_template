#!/bin/bash
#SBATCH --job-name=hardrrdq
#SBATCH --partition=gpu-v100-32g
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=30:00:00
#SBATCH --output=benchmark/slurm/logs/%x_%A_%a.out

# Ensure thread libraries respect Slurm's CPU allocation
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export MKL_NUM_THREADS=$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=$SLURM_CPUS_PER_TASK
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Parse array variables
env_ids={{env_ids}}
seeds={{seeds}}
env_id=${env_ids[$SLURM_ARRAY_TASK_ID / {{len_seeds}}]}
seed=${seeds[$SLURM_ARRAY_TASK_ID % {{len_seeds}}]}

echo "Running task $SLURM_ARRAY_TASK_ID on node $SLURMD_NODENAME | GPU: $CUDA_VISIBLE_DEVICES | env_id: $env_id | seed: $seed"

# Bind CPUs to allocated cores explicitly instead of --cpu-bind=none
srun --cpu-bind=cores {{command}} --env-id $env_id --seed $seed